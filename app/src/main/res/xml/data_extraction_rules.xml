<data-extraction-rules>
    <cloud-backup>
        <!-- Enforce local-only guarantee: exclude all notes, audio, and databases from Google Drive cloud backups -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all private notes, transcripts, audio, and databases from device-to-device migration -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
